@{
    ViewData["Title"] = "Home Page";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white" style="max-width: 480px; width: 100%;">
        <div class="d-flex flex-column align-items-center">
            
    
            <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex justify-content-center align-items-center mb-4" style="width: 96px; height: 96px; font-size: 3rem;">
                <i class="bi bi-stars"></i>
            </div>

 
            <h3 class="fw-bold text-dark mb-3">Bienvenido usuario</h2>

     
            <p class="text-secondary mb-1 fs-7">Su cuenta en el aplicativo X está activada.</p>
            <p class="text-secondary mb-5 fs-7">Ya puede iniciar sesión.</p>

           
          <div class="d-flex justify-content-center align-items-center">
            <a href="/Auth/Login" class="btn btn-primary btn-md w-100 rounded-pill fw-bold shadow-sm px-4 py-2" style="color: white;">
                Iniciar sesión
            </a>
            </div>

        </div>
    </div>
</div>
