<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Autenticación</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100" style="background-color: var(--bg-color);">

    <partial name="Partials/_AuthHeader" />


    <div class="background-l flex-grow-1 d-flex align-items-center justify-content-center">
        <div class="container w-100">
            <div class="row justify-content-center">
                <main role="main" class="col-12 col-md-8 col-lg-6 col-xl-5">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>
    <partial name="Partials/_Footer" />
    
  
    <partial name="Partials/_ToastNotifications" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
