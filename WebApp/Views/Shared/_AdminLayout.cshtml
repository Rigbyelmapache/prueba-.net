<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .admin-layout {
            display: flex;
            min-height: 100vh;
        }
        .admin-sidebar {
            width: 80px;
            background-color: #ffffff;
            border-right: 1px solid rgba(0,0,0,0.08); /* Sombra muy sutil */
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            align-items: center; /* Centrar todo horizontalmente */
            padding-top: 1.5rem;
            z-index: 1050; /* Garantiza estar por encima */
        }
        .admin-content-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            background-color: var(--bg-color);
        }
        .admin-main {
            flex-grow: 1;
            padding: 2rem;
            overflow-y: auto;
        }
        
        /* Botones personalizados de la barra lateral */
        .btn-sidebar {
            background-color: transparent;
            color: #1e293b;
            border: none;
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            transition: all 0.2s ease;
            padding: 0;
            font-size: 1.35rem; /* Tamaño del icono */
        }
        .btn-sidebar:hover, .btn-sidebar:active, .btn-sidebar.active {
            color: #d32f2f; /* Rojo al presionar o hover */
            background-color: rgba(220, 53, 69, 0.1); /* Rojo tenue en el fondo */
            box-shadow: none;
            outline: none;
        }
    </style>
</head>
<body>
    <div class="admin-layout">
        <!-- Sidebar -->
        <aside class="admin-sidebar shadow-sm">
       
            <div class="mb-4">
                <i class="bi bi-list fs-2 text-dark" style="cursor: pointer;"></i>
            </div>
           
            <div class="d-flex flex-column gap-3 w-100 align-items-center mt-3">
                <ui-link href="/Admin/Panel" title="Panel Principal">
                    <ui-button variant="sidebar active" icon="bi bi-house"></ui-button>
                </ui-link>
                
                <ui-link href="#" title="Instituciones">
                    <ui-button variant="sidebar" icon="bi bi-building"></ui-button>
                </ui-link>
                
                <ui-link href="/Admin/ListaUsuarios" title="ver usuarios">
                    <ui-button variant="sidebar" icon="bi bi-file-earmark-plus"></ui-button>
                </ui-link>
                
                <ui-link href="#" title="Búsqueda Avanzada">
                    <ui-button variant="sidebar" icon="bi bi-search"></ui-button>
                </ui-link>
            </div>
        </aside>

        <!-- Contenido y Header Principal -->
        <div class="admin-content-wrapper">
        
            <partial name="Partials/_AdminHeader" />

  
            <main class="admin-main">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <!-- 20 min inactivo -> Modal 49seg -->
    <ui-session-timeout idle-minutes="1" countdown-seconds="10"></ui-session-timeout>


    <partial name="Partials/_ToastNotifications" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
