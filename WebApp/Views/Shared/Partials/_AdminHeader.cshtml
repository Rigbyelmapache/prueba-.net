
<header class="navbar navbar-dark shadow-sm w-100" style="background-color: #9A1413 !important; padding: 0;">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center" style="height: 60px;">

        <div class="d-flex align-items-center">
    
            <div class="bg-white rounded d-flex justify-content-center align-items-center fw-bold" style="width: 35px; height: 35px; color: #9A1413;">
                LG
            </div>
        </div>


        <div class="d-flex align-items-center gap-4 text-white">
    
            <a href="#" class="text-white text-decoration-none fs-5 d-flex align-items-center" title="Ayuda">
                <i class="bi bi-question-circle"></i>
            </a>
            

            <a href="#" class="text-white text-decoration-none fs-5 d-flex align-items-center position-relative" title="Notificaciones">
                <i class="bi bi-bell"></i>
                <span class="position-absolute top-25 start-100 translate-middle p-1 border border-light rounded-circle" style="background-color: #ffc107;">
                    <span class="visually-hidden">Nuevas alertas</span>
                </span>
            </a>

            <div class="vr bg-white mx-1" style="opacity: 0.3;"></div>


            <div class="dropdown ">
                <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownAdminUser" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="text-end me-2 d-none d-md-block">
                        <div class="fw-bold lh-1" style="font-size: 0.95rem;">
                            @User.FindFirst("PrimerApellido")?.Value @User.FindFirst("SegundoApellido")?.Value
                        </div>
                        <div class="text-white-50 mt-1" style="font-size: 0.75rem;">
                            @User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                        </div>
                    </div>
                    <i class="bi bi-person-circle fs-3"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="dropdownAdminUser">
                    <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i> Mi Perfil</a></li>
                    <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i> Configuración</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="#" id="btnLogout"><i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión</a></li>
                </ul>
            </div>
        </div>
    </div>
</header>
