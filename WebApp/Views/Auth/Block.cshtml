@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Cuenta Bloqueada";
}

<div class="card shadow-lg border-0 rounded-4 text-center">
    <div class="card-body p-5">

        <div class="mb-4 mt-2">
            <i class="bi bi-headset text-primary" style="font-size: 5rem;"></i>
        </div>
        

        <h2 class="fw-bolder text-dark mb-3">Cuenta bloqueada temporalmente</h2>
        

        <p class="text-muted fs-5 mb-4 px-md-3" style="line-height: 1.6;">
            Has excedido el número máximo de intentos fallidos (5). 
            Por seguridad, tu cuenta ha sido bloqueada durante 15 minutos. 
            Intenta nuevamente más tarde.
        </p>

        
    </div>
</div>
